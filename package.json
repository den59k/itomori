{
  "name": "itomori",
  "version": "0.1.1",
  "description": "Compile a template string once into a fast, reusable (row) => string function",
  "type": "module",
  "main": "./dist/template.js",
  "types": "./dist/template.d.ts",
  "exports": {
    ".": {
      "import": "./dist/template.js",
      "types": "./dist/template.d.ts"
    }
  },
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "bun build src/template.ts --outdir dist --target node && tsc -p tsconfig.build.json",
    "test": "bun test",
    "prepublishOnly": "bun test && bun run build"
  },
  "keywords": [
    "template",
    "compiler",
    "table",
    "renderer"
  ],
  "license": "MIT",
  "author": "den59k <den59k@gmail.com>",
  "contributors": [
    "Claude Code <https://anthropic.com>"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/den59k/itomori.git"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5"
  }
}
